\newsavebox{\jnfront@box}
% 将各前置页作为一个整体输出，防止长名单悄悄溢出到背面。
\newenvironment{jnsinglefrontpage}{%
  \clearpage\begingroup
  \hypersetup{pageanchor=false}%
  \pagestyle{empty}\thispagestyle{empty}%
  \setstretch{1}\normalfont\songti\zihao{-4}%
  \setlength{\parindent}{0pt}\setlength{\parskip}{0pt}%
  \begin{lrbox}{\jnfront@box}\begin{minipage}{\textwidth}%
}{%
  \end{minipage}\end{lrbox}%
  \ifdim\dimexpr\ht\jnfront@box+\dp\jnfront@box\relax>\textheight
    \PackageError{jnfrontpages}{Front page exceeds the printable text area}{Shorten committee entries or reduce the number of blank rows.}%
  \fi
  \noindent\usebox{\jnfront@box}\par
  \clearpage\cleardoublepage
  \endgroup
  \hypersetup{pageanchor=true}%
}
\newcommand{\jnfrontheading}[1]{%
  \vspace*{15.6bp}%
  {\centering\normalfont\heiti\fontsize{16bp}{20bp}\selectfont #1\par}%
  \vspace{15.6bp}%
}
\newcommand{\jnstatementpage}{%
  \begin{jnsinglefrontpage}
    \input{preface/declaration.tex}%
  \end{jnsinglefrontpage}%
}

